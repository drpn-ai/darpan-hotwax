<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="list" noun="HotWaxOmsRestSourceConfigs" type="script" authz-action="view" allow-remote="true" authenticate="true"
            location="component://darpan-hotwax/src/main/groovy/darpan/hotwax/facade/settings/listOmsRestSourceConfigs.groovy">
        <description>List OMS source configurations available to the active tenant.</description>
        <in-parameters>
            <parameter name="query"/>
            <parameter name="pageIndex" type="Integer" default-value="0"/>
            <parameter name="pageSize" type="Integer" default-value="20"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"/>
            <parameter name="errors" type="List"/>
            <parameter name="omsRestSourceConfigs" type="List">
                <!-- House convention (matches ShopifyFacadeServices.xml and
                     SettingsFacadeServices.xml's list#NsAuthConfigs): declare every field the
                     service actually returns, not a subset. A List/Map out-parameter with a
                     partial child set publishes a contract that is actively false — this row is
                     OmsExtractSupport.safeConfigMapFromPlain plus isShared, in the
                     same order, so it stays truthful. Declaring the full set also happens to be
                     the only way a List out-parameter with exactly one child avoids the contract
                     generator reading it as "array of that child's scalar type" instead of "array
                     of objects" — but completeness is the actual rule; that quirk is a corollary. -->
                <parameter name="omsRestSourceConfigId"/>
                <parameter name="description"/>
                <parameter name="companyUserGroupId"/>
                <parameter name="baseUrl"/>
                <parameter name="timeZone"/>
                <parameter name="authType"/>
                <parameter name="hasUsername" type="Boolean"/>
                <parameter name="hasPassword" type="Boolean"/>
                <parameter name="hasApiToken" type="Boolean"/>
                <parameter name="customHeaderNames" type="List"/>
                <parameter name="connectTimeoutSeconds" type="Integer"/>
                <parameter name="readTimeoutSeconds" type="Integer"/>
                <parameter name="isActive"/>
                <parameter name="canReadOrders" type="Boolean"/>
                <parameter name="createdDate"/>
                <parameter name="lastUpdatedDate"/>
                <parameter name="isShared" type="Boolean"/>
            </parameter>
            <parameter name="pagination" type="Map">
                <parameter name="pageIndex" type="Integer"/>
                <parameter name="pageSize" type="Integer"/>
                <parameter name="totalCount" type="Integer"/>
                <parameter name="pageCount" type="Integer"/>
            </parameter>
        </out-parameters>
    </service>

    <service verb="save" noun="HotWaxOmsRestSourceConfig" type="script" allow-remote="true" authenticate="true"
            location="component://darpan-hotwax/src/main/groovy/darpan/hotwax/facade/settings/saveOmsRestSourceConfig.groovy">
        <description>Create or update a tenant-owned OMS source configuration. Secret fields are stored encrypted and are never returned in clear text.</description>
        <in-parameters>
            <parameter name="omsRestSourceConfigId"><description>DAR-BE-135: names a config this tenant owns or was granted,
                to update it. Leave it out to create one; the server mints the id.</description></parameter>
            <parameter name="description"/>
            <parameter name="baseUrl" required="true"/>
            <parameter name="timeZone" default-value="UTC"/>
            <parameter name="authType" default-value="NONE">
                <description>Supported values are NONE, BASIC, BEARER, and API_KEY. API_KEY sends the encrypted API token in the OMS Swagger-documented api_key header.</description>
            </parameter>
            <parameter name="username"/>
            <parameter name="password"/>
            <parameter name="apiToken"/>
            <parameter name="headersJson"/>
            <parameter name="connectTimeoutSeconds" type="Integer" default-value="30"/>
            <parameter name="readTimeoutSeconds" type="Integer" default-value="60"/>
            <parameter name="isActive" type="Boolean" default-value="true"/>
            <parameter name="canReadOrders" type="Boolean" default-value="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"/>
            <parameter name="errors" type="List"/>
            <parameter name="savedOmsRestSourceConfig" type="Map">
                <!-- Same shape as omsRestSourceConfigs' item schema above (list#HotWaxOmsRestSourceConfigs)
                     — safeConfigMapFromPlain plus isShared, declared in full per house convention. -->
                <parameter name="omsRestSourceConfigId"/>
                <parameter name="description"/>
                <parameter name="companyUserGroupId"/>
                <parameter name="baseUrl"/>
                <parameter name="timeZone"/>
                <parameter name="authType"/>
                <parameter name="hasUsername" type="Boolean"/>
                <parameter name="hasPassword" type="Boolean"/>
                <parameter name="hasApiToken" type="Boolean"/>
                <parameter name="customHeaderNames" type="List"/>
                <parameter name="connectTimeoutSeconds" type="Integer"/>
                <parameter name="readTimeoutSeconds" type="Integer"/>
                <parameter name="isActive"/>
                <parameter name="canReadOrders" type="Boolean"/>
                <parameter name="createdDate"/>
                <parameter name="lastUpdatedDate"/>
                <parameter name="isShared" type="Boolean"/>
            </parameter>
        </out-parameters>
    </service>

    <service verb="delete" noun="HotWaxOmsRestSourceConfig" type="script" allow-remote="true" authenticate="true"
            location="component://darpan-hotwax/src/main/groovy/darpan/hotwax/facade/settings/deleteOmsRestSourceConfig.groovy">
        <description>Delete one tenant-owned HotWax OMS source configuration.</description>
        <in-parameters>
            <parameter name="omsRestSourceConfigId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"/>
            <parameter name="errors" type="List"/>
            <parameter name="deleted" type="Boolean"/>
            <parameter name="deletedOmsRestSourceConfigId"/>
        </out-parameters>
    </service>

    <service verb="probe" noun="HotWaxOmsConnection" type="script" allow-remote="false" authenticate="true"
            location="component://darpan-hotwax/src/main/groovy/darpan/hotwax/facade/settings/probeOmsRestSourceConnection.groovy">
        <description>Connection diagnostics for a saved OMS source config: one orders(first: 1) GraphQL query.
            Registered on the OMS GraphQL connector rows as healthCheckServiceName and invoked only through
            facade.SettingsFacadeServices.test#SourceConnection, which owns the permission gate.
            Read-only, one record, no retries, no throttle wait. Never writes to ec.message: a rejected credential is
            a check row, not a service error.</description>
        <in-parameters>
            <parameter name="omsRestSourceConfigId" required="true"/>
            <parameter name="stage">
                <description>Run just this stage and report the next one, so the caller can show
                    progress as each completes. Blank runs every stage in a single call.</description>
            </parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="checks" type="List">
                <parameter name="check" type="Map">
                    <parameter name="key"/>
                    <parameter name="label"/>
                    <parameter name="status"/>
                    <parameter name="detail"/>
                    <parameter name="durationMillis" type="Long"/>
                </parameter>
            </parameter>
            <parameter name="nextStage">
                <description>Stage to run next, or blank when the probe is finished.</description>
            </parameter>
        </out-parameters>
    </service>

    <service verb="run" noun="OmsGraphqlAgentQuery" allow-remote="true" authenticate="true">
        <description>DAR-CLI-003. Runs one fresh, read-only GraphQL query a tenant user's agent wrote, through a HotWax OMS
            connection the active tenant stores. One query only (no mutation, subscription or introspection); the answer
            is returned as the OMS gave it, up to 5 MB; the connection's credentials are never returned. Needs run
            access. Every call is logged for the tenant.</description>
        <in-parameters>
            <parameter name="omsRestSourceConfigId" required="true"/>
            <!-- Final review B2: a GraphQL document may carry < and > (string filters); it is forwarded, never rendered. -->
            <parameter name="document" required="true" allow-html="any"/>
            <parameter name="variables" type="Map"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="data" type="Map"/>
            <parameter name="rowCount" type="Integer"><description>The edge count when the answer is one connection, else blank.</description></parameter>
            <parameter name="truncated" type="Boolean"/>
            <parameter name="durationMs" type="Long"/>
            <parameter name="code"/>
            <parameter name="retryAfterSeconds" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="queryResult" from="darpan.hotwax.oms.OmsAgentQuerySupport.runAgentQuery(ec, context)"/>
            <set field="data" from="queryResult?.data"/>
            <set field="rowCount" from="queryResult?.rowCount"/>
            <set field="truncated" from="queryResult?.truncated"/>
            <set field="durationMs" from="queryResult?.durationMs"/>
            <set field="code" from="queryResult?.code"/>
            <set field="retryAfterSeconds" from="queryResult?.retryAfterSeconds"/>
            <if condition="queryResult?.error">
                <message error="true">${queryResult.error}</message>
            </if>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="errors" from="ec.message.errors"/>
        </actions>
    </service>

    <service verb="get" noun="OmsGraphqlSchema" authz-action="view" allow-remote="true" authenticate="true">
        <description>DAR-CLI-003. The HotWax OMS GraphQL schema a tenant's agent can ask about, trimmed to the types reachable
            from the Query root (names, kinds, fields, arguments, enum values and descriptions; mutations and subscriptions
            left out). Read from the OMS once and kept 24 hours per connection. Needs view access.</description>
        <in-parameters>
            <parameter name="omsRestSourceConfigId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="schema" type="Map"/>
            <parameter name="code"/>
            <parameter name="retryAfterSeconds" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="schemaResult" from="darpan.hotwax.oms.OmsAgentQuerySupport.getSchema(ec, context)"/>
            <set field="schema" from="schemaResult?.schema"/>
            <set field="code" from="schemaResult?.code"/>
            <set field="retryAfterSeconds" from="schemaResult?.retryAfterSeconds"/>
            <if condition="schemaResult?.error">
                <message error="true">${schemaResult.error}</message>
            </if>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="errors" from="ec.message.errors"/>
        </actions>
    </service>

</services>
