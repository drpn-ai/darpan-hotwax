<?xml version="1.0" encoding="UTF-8"?>
<!--
  DAR-BE-318 plan 3b-1 (ruling P3b1-9). What the HotWax endpoints do that darpan core must know without naming HotWax: set
  here, on the core connector rows by primary key (the other fields stay core's), never in core.

  excludedRecordsSidecar: whether the records Keep sets aside are written beside the extract (the excluded-records side
  file). No HotWax extract takes source filters since DAR-BE-318 plan 3b-2b (Tasks 17-19): darpan's Spark Keep writes it
  when this says Y, and a kept-copy slice exactly when this says Y. Each row keeps what its read wrote before. Tied to the
  extracts by ExcludedRecordsSidecarTieTests.
    OMS_GQL N: Keep runs in Spark (Task 17). Its read never wrote one (DAR-BE-064), so a run that sets orders aside still
      reads them as unknown, as before.
    OMS_RETURNS_GQL N: Keep runs in Spark (Task 18). Its read never wrote one (DAR-BE-040 fix 3), so a run that sets returns
      aside still reads them as unknown (or absent, when only the built-in lines set them aside), as before.
    OMS_ORDER_ITEMS_GQL Y: Keep runs in Spark (Task 17), which writes the side file the unit-grain read used to. No
      keepLinesJson ([]): the read drops nothing of its own.
    OMS_PRODUCTS_GQL Y: Keep runs in Spark (Task 19), which writes the side file the products read used to, so a conclusion
      can still name a product R22 sets aside. keepLinesJson []: the read drops nothing of its own.
  keepLinesJson (DAR-BE-318, Ruling 3b2b-12): built-in Keep lines, run in Spark before the tenant's rules.
    OMS_GQL: an exchange order (isExchangeOrder = Y, written by the orders extract) is set aside unless the side keeps
      exchange orders (keepExchangeOrders, DAR-BE-345: "every order HotWax approves reaches NetSuite" compares them). The
      read is the same whichever sides share it; only the side's Keep differs. A read with the exchange exclusion off (a
      conclusion lookup) writes no flag, so there is nothing for the line to set aside. Its exchange manifest is still
      written for the exchange-pair verify pass.
  extractOptionsJson (OMS_GQL, DAR-BE-345): keepExchangeOrders, off unless a run side turns it on (absent is the default,
    so no existing side's read, Keep or kept-copy options key changes). The orders extract takes it too, so a re-read by key
    writes exchange orders flagged, as the window read does, instead of leaving them out.
    withOrderItems (DAR-BE-368): off unless a run side turns it on; on, the side also reads each order's items (orderItems), so
    an audit finding about the order lists its lines with their SKUs.
    OMS_RETURNS_GQL: a cancelled return (omsReturnClass = CANCELLED, written by the returns extract) is set aside unless the
      side reads only cancelled returns; one with no Shopify reference (NO_SHOPIFY_REF) unless the side keeps those
      (includeReturnsWithoutShopifyRef) or reads only cancelled ones. The read counts both as before.
  isExchangeOrder and omsReturnClass are fields like any other (Aditi, 2026-11-21): offered on the rules board below.
  servingProjectionServiceName: the orders and returns extracts trim records to the keep fields they are sent; a kept copy
    is trimmed the same way by project#HotWaxOmsKeptRecords (OmsKeptRecordsServing).
  datasetReadParametersJson: a dataset read of 60 days lists every exchange order it sets aside (a run lists 500), so a
    slice can list a day's as that day's live read would.
-->
<entity-facade-xml type="darpan-seed">
    <darpan.reconciliation.SourceSystemConnector systemEnumId="OMS_GQL" excludedRecordsSidecar="N"
            servingProjectionServiceName="reconciliation.HotWaxOmsExtractionServices.project#HotWaxOmsKeptRecords"
            datasetReadParametersJson='{"exchangeManifestMaxEntries":50000}'
            extractOptionsJson='[{"name":"keepExchangeOrders","label":"Keep exchange orders","type":"boolean"},{"name":"withOrderItems","label":"Order items","type":"boolean"}]'
            keepLinesJson='[{"sequenceNum":0,"label":"isExchangeOrder","appliesUnless":{"keepExchangeOrders":true},"kinds":{"isExchangeOrder":"FVT_TEXT"},"lines":[{"conditionSeqId":"01","sequenceNum":1,"conditionTypeId":"RCT_COMPARE","fieldName":"isExchangeOrder","operatorEnumId":"ENTCO_EQUALS","compareValue":"Y"}]}]'/>
    <darpan.reconciliation.SourceSystemConnectorField systemEnumId="OMS_GQL" fieldPath="$.records[*].isExchangeOrder"
            label="Exchange order" fieldType="string" sequenceNum="14"
            description="DAR-BE-318: Y when the order carries an EXCHANGE item association, else N. Written by the orders extract on every window read whatever it keeps; the built-in Keep line (keepLinesJson) sets the Y orders aside unless the side keeps exchange orders (keepExchangeOrders). Conclusion lookups write no flag."/>
    <darpan.reconciliation.SourceSystemConnector systemEnumId="OMS_RETURNS_GQL" excludedRecordsSidecar="N"
            servingProjectionServiceName="reconciliation.HotWaxOmsExtractionServices.project#HotWaxOmsKeptRecords"
            keepLinesJson='[{"sequenceNum":0,"label":"omsReturnClass","appliesUnless":{"onlyCancelledReturns":true},"kinds":{"omsReturnClass":"FVT_TEXT"},"lines":[{"conditionSeqId":"01","sequenceNum":1,"conditionTypeId":"RCT_COMPARE","fieldName":"omsReturnClass","operatorEnumId":"ENTCO_EQUALS","compareValue":"CANCELLED"}]},{"sequenceNum":1,"label":"omsReturnClass","appliesUnless":{"includeReturnsWithoutShopifyRef":true,"onlyCancelledReturns":true},"kinds":{"omsReturnClass":"FVT_TEXT"},"lines":[{"conditionSeqId":"01","sequenceNum":1,"conditionTypeId":"RCT_COMPARE","fieldName":"omsReturnClass","operatorEnumId":"ENTCO_EQUALS","compareValue":"NO_SHOPIFY_REF"}]}]'/>
    <darpan.reconciliation.SourceSystemConnectorField systemEnumId="OMS_RETURNS_GQL" fieldPath="$.records[*].omsReturnClass"
            label="Return class" fieldType="string" sequenceNum="15"
            description="DAR-BE-318: KEEP, CANCELLED (RETURN_CANCELLED) or NO_SHOPIFY_REF (neither a Shopify refund id nor a Shopify return id). Written by the returns extract on every window read whatever it keeps, and by a read by returnId on what it keeps; the replacement-order lookup writes none. The built-in Keep lines (keepLinesJson) set the CANCELLED and NO_SHOPIFY_REF returns aside unless the side's options keep them."/>
    <darpan.reconciliation.SourceSystemConnector systemEnumId="OMS_ORDER_ITEMS_GQL" excludedRecordsSidecar="Y" keepLinesJson="[]"/>
    <darpan.reconciliation.SourceSystemConnector systemEnumId="OMS_PRODUCTS_GQL" excludedRecordsSidecar="Y" keepLinesJson="[]"/>
</entity-facade-xml>
